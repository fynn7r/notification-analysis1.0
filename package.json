{
  "name": "notizhi",
  "version": "0.1.0",
  "description": "通知智析：把群通知与公众号文章解析成结构化待办，支持双知识库与配图文字识别",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev:standalone": "concurrently --kill-others --names api,web \"node --watch server/index.mjs\" \"vite --config vite.standalone.config.ts\"",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "preview:standalone": "concurrently --kill-others --names api,web \"node server/index.mjs\" \"vite preview --config vite.standalone.config.ts\"",
    "test:api": "node --test server/parse.test.mjs server/generate.test.mjs server/interpret.test.mjs server/ai-settings.test.mjs server/rule-document.test.mjs server/knowledge.test.mjs server/remote.test.mjs server/article-extract.test.mjs server/vision-service.test.mjs server/static-server.test.mjs",
    "test:knowledge": "node --test server/knowledge.test.mjs",
    "admin:knowledge": "node scripts/knowledge-admin.mjs",
    "dev:remote": "node server/remote.mjs",
    "dev:wechat-gate": "node --watch server/wechat-gate.mjs",
    "test:wechat-gate": "node --test server/wechat-gate.test.mjs",
    "verify:wechat": "node scripts/wechat-preflight.mjs",
    "test:browser": "playwright test",
    "verify:live": "node scripts/verify-live-parse.mjs",
    "verify:generate:live": "node scripts/verify-live-generate.mjs",
    "verify:interpret:live": "node scripts/verify-live-interpret.mjs",
    "verify:rules:layout": "node scripts/verify-rule-layout.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.app.json",
    "lint": "concurrently npm:typecheck npm:lint:eslint",
    "lint:eslint": "eslint src",
    "precommit": "npm run lint",
    "prepare": "node scripts/setup-git-hooks.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@lark-apaas/client-toolkit-lite": "^1.1.30",
    "@napi-rs/canvas": "^1.0.10",
    "@radix-ui/react-accordion": "^1.2.11",
