    "react-router-dom": "^7.13.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.2.0",
    "vaul": "^1.1.2",
    "word-extractor": "^1.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lark-apaas/coding-preset-vite-react": "^1.0.25",
    "@lark-apaas/coding-presets-react": "^0.1.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9",
    "eslint": "^9",
    "typescript": "~5.9",
    "vite": "^8"
  },
  "actionPlugins": {
    "@official-plugins/ai-doc-parser": "1.0.16",
    "@official-plugins/ai-text-summary": "1.0.11",
    "@official-plugins/ai-categorization": "1.0.21",
    "@official-plugins/ai-text-to-json": "1.0.26",
    "@official-plugins/ai-text-generate": "1.0.21"
  }
}
