# ============================================================
# TASK-001 M0 微信客服接入 — 配置样例
# 复制为 .env.wechat.local 并填写真实值
# 所有值均来自微信客服管理后台
# ============================================================

# ── 企业管理后台（企业微信管理后台 → 我的企业 → 企业信息）──
WECOM_CORP_ID=ww_你的企业ID

# ── 微信客服 Secret（应用管理 → 微信客服 → 开发配置）───────
WECOM_SECRET=你的微信客服Secret

# ── 回调配置（开发配置 → 接收消息服务器） ────────────────────
# Token：任意 3-32 位英文字母或数字
WECOM_TOKEN=自己填写的Token
# EncodingAESKey：随机 43 位英文字母或数字（后台可自动生成）
WECOM_ENCODING_AES_KEY=后台生成的43位EncodingAESKey

# ── 客服账号 ID（微信客服 → 客服账号 → 详情） ────────────────
WECOM_OPEN_KFID=你的客服账号ID

# ── 公网地址（回调 URL，微信后台「接收消息服务器」必须与此一致） ──
# 未认证企业：填 http://公网IP:端口/wechat/callback
#   例：http://1.2.3.4:8080/wechat/callback
# 已认证企业：必须是与本企业主体一致的备案域名
# 注意：trycloudflare / workers.dev 等非本主体的域名必然校验失败（-50025）
WECHAT_GATE_PUBLIC_URL=

# ── 测试发送者白名单（逗号分隔的微信发送者 ID） ──────────────
# 首次使用留空，从 .local/wechat-gate/ 日志中获取自己的发送者 ID 后填入
WECHAT_GATE_TESTER_IDS=

# ── 可选：网关端口（默认 3002） ──────────────────────────────
# WECHAT_GATE_PORT=3002

# ── 可选：监听地址（默认 127.0.0.1） ─────────────────────────
# 服务器上用 Nginx 反代时保持默认；确需直连公网时才改为 0.0.0.0
# WECHAT_GATE_HOST=127.0.0.1

# ── 可选：数据目录（默认 <项目>/.local/wechat-gate） ─────────
# 服务器建议独立到持久卷，避免部署覆盖：/var/lib/notizhi/wechat-gate
# WECHAT_GATE_STORE=/var/lib/notizhi/wechat-gate