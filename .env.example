# 复制为 .env.local；此文件仅由 Node 服务读取，密钥不会发送给浏览器。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 可选；留空则复用 AI_MODEL，共用上面的地址和密钥。
AI_INTERPRET_MODEL=
AI_GENERATE_MODEL=
# 可选；非 DeepSeek 服务可填写控制台地址，方便查看额度和账单。
AI_CONSOLE_URL=
# 单次请求超时（毫秒）。思考型模型输出长文较慢，长通知解读实测约需 80 秒，不要设得过小。
AI_TIMEOUT_MS=120000
# 单次输出的 token 上限。留空按服务商自动选择：官方 DeepSeek 用 8192（其上限），
# 其他网关用 16384。思考型模型的思考过程与正文共用这一额度，
# 出现“输出达到上限被截断”时可在“我的 → 模型接入”页面调高，不必改这里。
# AI_MAX_TOKENS=16384
API_PORT=3001

# 可选：公众号配图的文字识别（海报、截图类通知用得上）。
# 留空则只保留 [图片 N] 占位符并提示"未读取图中文字"，不影响正文解析。
# 需填支持视觉的模型，例如 DeepSeek 官方 deepseek-flash，或 qwen3-vl-plus。
# AI_VISION_MODEL=
# 视觉模型与文本模型不同源时，可单独指定地址与密钥；不填则复用上面的配置。
# AI_VISION_BASE_URL=
# AI_VISION_API_KEY=
AI_VISION_TIMEOUT_MS=60000
